# What the SFD-DJ.EU Discord bot reads. A real environment variable wins; after that the first of these files that names it:
# this file's real twin (bot/.env), then the website's own .env one folder up. So the DISCORD_* lines the website already has are enough.
# Never write real values in this example file.

# --- Needed -------------------------------------------------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# --- Roles and channels (each one switches a feature on) ----------------------------------------------------------------------------
# the role every new member gets
DISCORD_MEMBER_ROLE_ID=
# where /apply and the website's staff applications arrive, who may review them, and the role an approved applicant gets
DISCORD_STAFF_APPLICATIONS_CHANNEL_ID=
DISCORD_STAFF_ROLE_ID=
DISCORD_APPROVED_STAFF_ROLE_ID=
# where kicks, bans and unbans are logged
DISCORD_MOD_LOG_CHANNEL_ID=

# --- The staff application form (the three questions; these are the defaults) --------------------------------------------------------
# DISCORD_STAFF_QUESTION_MOTIVATION="Why do you want to join the staff team?"
# DISCORD_STAFF_QUESTION_EXPERIENCE="What relevant experience do you have?"
# DISCORD_STAFF_QUESTION_AVAILABILITY="When are you usually available?"

# --- Optional ---------------------------------------------------------------------------------------------------------------------
# The site the bot belongs to: what it shows under its name ("Listening to https://sfd-dj.eu/"), links to, and asks for /profile and website announcements.
# Only a public address counts: localhost, private networks and "${APP_URL}" are ignored and the live site is used.
# DISCORD_WEBSITE_URL=https://sfd-dj.eu
# What /status checks (the website's address when not set)
# DISCORD_STATUS_URL=https://sfd-dj.eu
# Where the bot keeps what the servers set up (default: data/settings.json in this folder)
# DISCORD_BOT_SETTINGS_PATH=
