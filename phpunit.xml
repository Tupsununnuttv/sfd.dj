<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- never the cached config (php artisan config:cache): it points at the real database, which RefreshDatabase would wipe -->
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.testing-never.php" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!-- with the Vite dev server running (public/hot) Inertia asks it to render each page, and Http::preventStrayRequests() turned that into a 500 in about a third of the tests -->
        <env name="INERTIA_SSR_ENABLED" value="false" force="true"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="YOUTUBE_API_KEY" value=""/>
        <!-- the real keys in .env never reach a test: one without Http::fake() would call the real Stripe, Discord, Spotify ... (it once made a live Stripe checkout page) -->
        <env name="STRIPE_SECRET" value="" force="true"/>
        <env name="STRIPE_WEBHOOK_SECRET" value="" force="true"/>
        <env name="DISCORD_BOT_TOKEN" value="" force="true"/>
        <env name="DISCORD_CLIENT_ID" value="" force="true"/>
        <env name="DISCORD_CLIENT_SECRET" value="" force="true"/>
        <env name="DISCORD_GUILD_ID" value="" force="true"/>
        <env name="DISCORD_ROLE_PREFIX" value="SFD-DJ.EU | " force="true"/><!-- the tests name their fake Discord roles with the default prefix, whatever .env says -->
        <env name="DISCORD_MEMBER_ROLE_ID" value="" force="true"/>
        <env name="SPOTIFY_CLIENT_ID" value="" force="true"/>
        <env name="SPOTIFY_CLIENT_SECRET" value="" force="true"/>
        <env name="TWITCH_CLIENT_ID" value="" force="true"/>
        <env name="TWITCH_CLIENT_SECRET" value="" force="true"/>
        <env name="TIKTOK_CLIENT_KEY" value="" force="true"/>
        <env name="TIKTOK_CLIENT_SECRET" value="" force="true"/>
        <env name="YOUTUBE_CLIENT_ID" value="" force="true"/>
        <env name="YOUTUBE_CLIENT_SECRET" value="" force="true"/>
        <env name="GIPHY_API_KEY" value="" force="true"/>
        <env name="GIPHY_SDK_API_KEY" value="" force="true"/>
        <env name="TENOR_API_KEY" value="" force="true"/>
        <env name="RESEND_API_KEY" value="" force="true"/>
        <env name="POSTMARK_API_KEY" value="" force="true"/>
        <env name="AWS_ACCESS_KEY_ID" value="" force="true"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
