{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "workspaces": [
        "apps/api"
    ],
    "engines": {
        "node": "24.x"
    },
    "type": "module",
    "scripts": {
        "build": "npm run build --workspace @sfddj/api && tsc && vite build --config vite.vercel.config.js",
        "dev": "vite",
        "dev:api": "npm run dev --workspace @sfddj/api",
        "test:api": "npm run test --workspace @sfddj/api"
    },
    "devDependencies": {
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^24.19.1",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.10",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "^10.4.12",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.31",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.0.2",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@laravel/echo-react": "^2.5.0",
        "laravel-echo": "^2.5.0",
        "lucide-react": "^1.52.0",
        "node": "^26.11.1",
        "nodemon": "^3.1.14",
        "pusher-js": "^8.6.0",
        "qrcode": "^1.5.4"
    }
}
