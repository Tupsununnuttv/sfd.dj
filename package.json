{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "engines": {
        "node": "26.x"
    },
    "type": "module",
    "scripts": {
        "test:frontend": "node --test tests/Frontend/*.test.mjs",
        "test:browsers": "playwright test",
        "test:browsers:install": "playwright install chromium firefox",
        "avatars:previews": "node scripts/character-posters.mjs",
        "backgrounds:previews": "node scripts/background-thumbnails.mjs",
        "build": "node scripts/character-posters.mjs && node scripts/background-thumbnails.mjs && tsc && vite build",
        "dev": "concurrently --names web,bot \"vite\" \"npm:bot:dev\"",
        "bot:install": "npm --prefix bot install",
        "bot:dev": "npm --prefix bot run dev",
        "bot:start": "npm --prefix bot start"
    },
    "devDependencies": {
        "@headlessui/react": "^2.2.10",
        "@inertiajs/react": "^3.9.1",
        "@playwright/test": "^1.64.1",
        "@resvg/resvg-js": "^2.6.2",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "^10.6.1",
        "concurrently": "^10.0.6",
        "laravel-vite-plugin": "^3.2.0",
        "postcss": "^8.5.30",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.4"
    },
    "dependencies": {
        "@laravel/echo-react": "^2.6.1",
        "laravel-echo": "^2.6.1",
        "lucide-react": "^1.57.0",
        "node": "^26.12.0",
        "pusher-js": "^8.6.0",
        "qrcode": "^1.5.4"
    }
}
