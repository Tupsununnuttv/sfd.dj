{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "engines": {
        "node": "24.x"
    },
    "type": "module",
    "scripts": {
        "build": "tsc && vite build",
        "dev": "concurrently --names web,bot \"vite\" \"npm:bot:dev\"",
        "bot:dev": "node --watch bot/index.js",
        "bot:start": "node bot/index.js"
    },
    "devDependencies": {
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^24.19.1",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.10",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "^10.4.12",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.31",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.0.2",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@laravel/echo-react": "^2.5.0",
        "discord.js": "^14.27.0",
        "laravel-echo": "^2.5.0",
        "lucide-react": "^1.52.0",
        "node": "^26.11.1",
        "pusher-js": "^8.6.0",
        "qrcode": "^1.5.4"
    }
}
