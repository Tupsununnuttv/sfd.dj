{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "env": {
        "DB_CONNECTION": "pgsql"
    },
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 60,
            "excludeFiles": "{node_modules/**,public/backgrounds/**,resources/js/**,resources/css/**,tests/**,storage/logs/**,.vercel/**}"
        }
    },
    "regions": ["fra1"],
    "routes": [
        { "src": "/", "dest": "/api/index.php" },
        { "src": "/(.*\\.php)(/.*)?", "dest": "/api/index.php" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}